---
import '../styles/global.css';
import { nav, site, contactLinks } from '../config/site';
import { withBase } from '../utils/paths';
import AtmosphericBackground from '../components/shared/AtmosphericBackground.astro';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  home?: boolean;
};

const {
  title = site.title,
  description = site.description,
  image,
  home = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = image ? new URL(withBase(image), Astro.site ?? Astro.url.origin) : undefined;

const isActive = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  const current = currentPath.replace(/\/$/, '') || '/';
  if (target === (withBase('/').replace(/\/$/, '') || '/')) return current === target;
  return current === target || current.startsWith(`${target}/`);
};
const links = home ? [
  { label: 'Home', href: '#home' },
  { label: 'About', href: '#about' },
  { label: 'Connect', href: '#connect' },
  { label: 'CV', href: withBase('/cv') },
] : nav.map((item) => ({ ...item, href: withBase(item.href) }));
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101f22" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <title>{title}</title>
  </head>
  <body class:list={[home ? 'page-home' : 'page-document']} data-mood={home ? 'hero' : 'document'}>
    <AtmosphericBackground />
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="site-name" href={withBase('/')} aria-label={`${site.name} home`}>Shinji<span class="name-dot">.</span></a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          {links.map((item) => (
            <a
              href={item.href}
              class:list={['nav-link', { active: home ? item.href === '#home' : isActive(item.href) }]}
              aria-current={(home ? item.href === '#home' : isActive(item.href)) ? (home ? 'location' : 'page') : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <details class="mobile-nav">
          <summary aria-label="Open navigation">Menu</summary>
          <nav aria-label="Mobile navigation">
            {links.map((item) => (
              <a
                href={item.href}
                class:list={['mobile-nav-link', { active: home ? item.href === '#home' : isActive(item.href) }]}
                aria-current={(home ? item.href === '#home' : isActive(item.href)) ? (home ? 'location' : 'page') : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>{site.footer}</p>
        <nav aria-label="Contact links" class="footer-links">
          {contactLinks.map((link) => (
            <a href={link.href} rel={link.href.startsWith('http') ? 'me noreferrer' : undefined}>{link.label}</a>
          ))}
          <a href={withBase(home ? '/cv' : '/')}>{home ? 'Curriculum vitae' : 'Back home'} <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </footer>
  </body>
</html>
<script>
  import { initIntro } from '../scripts/intro';
  initIntro();
</script>
